. 
. preserve

. tempfile event_results

. tempname event_handle

. postfile `event_handle' relative_year str12 term estimate std_error t_value p
> _value using `event_results', replace
(file /var/folders/l9/dnh5jmfj53q02s7qff8c36r40000gn/T//St58446.000003 not
    found)

. foreach event in "-4 event_m4" "-3 event_m3" "-2 event_m2" "0 event_p0" "1 ev
> ent_p1" "2 event_p2" "3 event_p3" "4 event_p4" {
  2.   local relative_year = word("`event'", 1)
  3.   local coefficient = word("`event'", 2)
  4.   local estimate = _b[`coefficient']
  5.   local std_error = _se[`coefficient']
  6.   local t_value = `estimate' / `std_error'
  7.   local p_value = 2 * ttail(e(df_r), abs(`t_value'))
  8.   post `event_handle' (`relative_year') ("`coefficient'") (`estimate') (`s
> td_error') (`t_value') (`p_value')
  9. }

. postclose `event_handle'

. use `event_results', clear

. export delimited using "`output_dir'/stata_event_study.csv", replace
file output/stata_event_study.csv saved

. gen ci_low = estimate - invnormal(0.975) * std_error

. gen ci_high = estimate + invnormal(0.975) * std_error

. sort relative_year

. twoway (rcap ci_high ci_low relative_year, lcolor(navy)) ///
>   (connected estimate relative_year, mcolor(navy) lcolor(navy)), ///
>   yline(0, lcolor(gs8) lpattern(dash)) ///
>   xline(-0.5, lcolor(maroon) lpattern(dash)) ///
>   xlabel(-4(1)4) ///
>   xtitle("Years relative to digital adoption") ///
>   ytitle("Coefficient relative to year -1") ///
>   title("Event-study estimates with 95% CI") ///
>   legend(off) graphregion(color(white)) bgcolor(white)

. graph export "`output_dir'/stata_event_study_ci.png", replace width(2000)
file output/stata_event_study_ci.png written in PNG format

. restore

. 
. preserve

