. estimates store event_study

. 
. * 收集事件研究系数和置信区间
. clear

. * 计算事件研究系数的数量
. local n_events = `n_cats' - 1

. set obs `n_events'
Number of observations (_N) was 0, now 9.

. 
. gen relative_period = .
(9 missing values generated)

. gen coefficient = .
(9 missing values generated)

. gen ci_lower = .
(9 missing values generated)

. gen ci_upper = .
(9 missing values generated)

. 
. * 遍历各期，收集系数
. local obs_idx = 1

. local var_idx = 1

. foreach val of local rel_values {
  2.     if `val' != -1 {
  3.         local coef = _b[treat_x_rel`var_idx']
  4.         local se_val = _se[treat_x_rel`var_idx']
  5.         local ci_l = `coef' - 1.96 * `se_val'
  6.         local ci_u = `coef' + 1.96 * `se_val'
  7. 
.         replace relative_period = `val' in `obs_idx'
  8.         replace coefficient = `coef' in `obs_idx'
  9.         replace ci_lower = `ci_l' in `obs_idx'
 10.         replace ci_upper = `ci_u' in `obs_idx'
 11. 
.         local obs_idx = `obs_idx' + 1
 12.     }
 13.     local var_idx = `var_idx' + 1
 14. }
