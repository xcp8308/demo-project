. * 4. 事件研究
. * ============================================================
. 
. * 重新读取数据
. import delimited using "data/raw/digital_transformation_firm_panel.csv", ///
>     clear bindquotes(strict) case(preserve)
(encoding automatically selected: ISO-8859-2)
(17 vars, 3,240 obs)

. 
. * 生成相对年份虚拟变量（以 relative_year = -1 即处理前一年为基准）
. tabulate relative_year, gen(rel_yr_)

relative_ye |
         ar |      Freq.     Percent        Cum.
------------+-----------------------------------
        -99 |      1,881       58.06       58.06
         -4 |        151        4.66       62.72
         -3 |        151        4.66       67.38
         -2 |        151        4.66       72.04
         -1 |        151        4.66       76.70
          0 |        151        4.66       81.36
          1 |        151        4.66       86.02
          2 |        151        4.66       90.68
          3 |        151        4.66       95.34
          4 |        151        4.66      100.00
------------+-----------------------------------
      Total |      3,240      100.00

. 
. * 基准组为 relative_year = -1（处理前一年）
. * 注意：rel_yr_1 对应 relative_year = -4，数字按升序排列
. * 需要找出 -1 对应的是第几个虚拟变量
. 
. * 先看一下 relative_year 的取值
. quietly tabulate relative_year

. local n_cats = r(r)

. 
. * 确定基准组：relative_year == -1 对应哪个虚拟变量
. levelsof relative_year, local(rel_values)
-99 -4 -3 -2 -1 0 1 2 3 4

. local base_idx = 1

. local i = 1

. foreach val of local rel_values {
  2.     if `val' == -1 {
  3.         local base_idx = `i'
  4.     }
  5.     local i = `i' + 1
  6. }

. display "基准组 relative_year=-1 对应虚拟变量 rel_yr_`base_idx'"
基准组 relative_year=-1 对应虚拟变量 rel_yr_5

. 
. * 去掉基准组，生成交互项（treated × 各期虚拟变量）
. * 先生成 treated × relative_year 各期交互项
. forvalues j = 1/`n_cats' {
  2.     if `j' != `base_idx' {
  3.         gen treat_x_rel`j' = treated * rel_yr_`j'
  4.     }
  5. }

. 
. * 事件研究回归：用交互项替换 digital
. local event_vars ""

. forvalues j = 1/`n_cats' {
  2.     if `j' != `base_idx' {
  3.         local event_vars "`event_vars' treat_x_rel`j'"
  4.     }
  5. }

. 
. display "事件研究回归变量：`event_vars'"
事件研究回归变量： treat_x_rel1 treat_x_rel2 treat_x_rel3 treat_x_rel4 treat_x_
> rel6 treat_x_rel7 treat_x_rel8 treat_x_rel9 treat_x_rel10

. reghdfe log_tfp `event_vars', absorb(firm_id year) vce(cluster firm_id)
